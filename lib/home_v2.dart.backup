      TextEditingController();
  final PageController bannerController = PageController();


    int currentBanner = 0;
    Timer? bannerTimer;
    List<Product> filteredProducts = List.from(products);
List<Product> suggestions = [];

final List<String> categories = [
  "✨ For You",
  "⚡ Electronics",
  "🛒 Kirana & Grocery",
  "💄 Beauty",
  "👕 Fashion",
  "👟 Footwear",
  "🧴 Personal Care",
